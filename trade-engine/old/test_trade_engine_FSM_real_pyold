@pytest.mark.parametrize(
    "case",
    handle_test_cases,
    ids=[c["name"] for c in handle_test_cases],
)
def test_trade_engine_FSM(case):
    """
    Тестирование TradeEngine с различными сценариями
    """
    config = qdrant_config
    repo = QdrantRepository(symbol="test", config=config)

    base_df = read_data(
        input_file="data/candles/BTCUSDT/ma_added/BTCUSDT_5m_ma.csv",
        offset_hours=0,
        limit_hours=100,
    )

    segments = get_segments(base_df)

    for idx, segment in enumerate(segments[:8]):
        segment.update_pattern_characteristics(
            base_df["ma_50"].tolist(), base_df["ma_200"].tolist()
        )
        # segment.Params.direction = Direction.UP

        repo.upsert(id=idx, segment=segment)

    trade_engine_FSM = TradeEngineReversalV2(
        repository=repo,
        avg_candle_len=case["avg_candle_len"],
        last_id=7,
        expire_in=365,
        neighbor_limit=5,
    )
    # Prepare the initial state
    for candle in case["initial_candles"]:
        trade_engine_FSM.handle_first(candle)

    # Handle the current candle
    trade_engine_FSM.handle_first(case["candle"])

    # Assertions
    assert trade_engine_FSM.current_state.id == case["expected_state"]

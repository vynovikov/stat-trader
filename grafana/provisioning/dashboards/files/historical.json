                    "pluginVersion": "4.13.0",
                    "queryType": "timeseries",
                    "rawSql": "WITH trade AS (\n  SELECT \n    t.entry_price, \n    t.candle_action,\n    t.open_time AS trade_time,\n    dateDiff('minute', c.open_time, c.close_time) AS timeframe_minutes\n  FROM trades_historical t\n  LEFT JOIN (\n    SELECT trade_id, open_time, close_time\n    FROM candles_historical\n    WHERE trade_id = ${trade_id}\n    LIMIT 1\n  ) c ON t.id = c.trade_id\n  WHERE (t.id = ${trade_id}) AND (t.engine_id = '${engine_id}')\n  LIMIT 1\n)\nSELECT\n  time,\n  if(candle_action = 'buy', entry_price, NULL) AS entry_buy,\n  if(candle_action = 'sell', entry_price, NULL) AS entry_sell\nFROM (\n  SELECT trade_time AS time, entry_price, candle_action FROM trade\n  UNION ALL\n  SELECT trade_time + INTERVAL ifNull(timeframe_minutes, 5) MINUTE AS time, entry_price, candle_action FROM trade\n) AS points\nORDER BY time",
                    "refId": "entry"
                },
                {
                    "datasource": {
                        "type": "grafana-clickhouse-datasource",
                        "uid": "cfacnscusrzeof"
                    },
                    "editorType": "sql",
                    "format": 1,
                    "hide": false,
                    "meta": {
                        "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                        }
                    },
                    "pluginVersion": "4.13.0",
                    "queryType": "table",
                    "rawSql": "SELECT\n  c.close_time AS time,\n  t.stop_loss  AS value\nFROM\n(\n  SELECT close_time\n  FROM candles_historical\n  WHERE trade_id = ${trade_id}  \n  ORDER BY close_time\n) c\nCROSS JOIN\n(\n  SELECT stop_loss\n  FROM trades_historical\n  WHERE (id = ${trade_id}) AND (engine_id = '${engine_id}')\n  LIMIT 1\n) t\nORDER BY time\n",
                    "refId": "sl"
                },
                {
                    "datasource": {

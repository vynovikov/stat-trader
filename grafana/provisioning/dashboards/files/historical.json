                    "queryType": "table",
                    "rawSql": "SELECT\n  c.close_time AS time,\n  t.take_profit  AS value\nFROM\n(\n  SELECT close_time\n  FROM candles_historical\n  WHERE trade_id = ${trade_id}  \n  ORDER BY close_time\n) c\nCROSS JOIN\n(\n  SELECT take_profit\n  FROM trades_historical\n  WHERE (id = ${trade_id}) AND (engine_id = '${engine_id}')\n  LIMIT 1\n) t\nORDER BY time\n",
                    "refId": "tp"
                }

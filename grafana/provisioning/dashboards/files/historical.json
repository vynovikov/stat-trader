                {
                    "datasource": {
                        "type": "grafana-clickhouse-datasource",
                        "uid": "cfacnscusrzeof"
                    },
                    "editorType": "sql",
                    "format": 0,
                    "hide": false,
                    "meta": {
                        "builderOptions": {

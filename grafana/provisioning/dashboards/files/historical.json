                    "queryType": "timeseries",
                    "rawSql": "SELECT \n    open_time AS time,\n    open,\n    high,\n    low,\n    close\nFROM candles_historical\nWHERE \n    trade_id = $trade_id AND (engine_id = '${engine_id}')\nORDER BY open_time",

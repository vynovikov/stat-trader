          "pluginVersion": "4.14.0",
          "queryType": "table",
          "rawSql": "SELECT\n  t.open_time AS time,\n  t.profit AS value,\n  t.id AS id,\n  t.engine_id AS engine_id,\n  toUnixTimestamp(coalesce(c.first_open, t.open_time)) * 1000 AS time_from,\n  toUnixTimestamp(coalesce(c.last_close, t.close_time)) * 1000 AS time_to,\n  greatest(t.take_profit, t.stop_loss) AS max_level,\n  least(t.take_profit, t.stop_loss) AS min_level\nFROM trades_real t\nLEFT JOIN (\n  SELECT\n    trade_id,\n    min(open_time) AS first_open,\n    max(close_time) AS last_close\n  FROM candles_traded\n  WHERE trade_id IS NOT NULL\n  GROUP BY trade_id\n) c ON t.id = c.trade_id\nWHERE t.open_time >= toDateTime($__from / 1000)\n  AND t.open_time <= toDateTime($__to / 1000)\nORDER BY t.open_time ASC",
          "refId": "A"
        }
      ],

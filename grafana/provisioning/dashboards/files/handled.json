          "pluginVersion": "4.13.0",
          "queryType": "table",
          "rawSql": "WITH numbered AS (\n    SELECT \n        profit,\n        open_time,\n        row_number() OVER (ORDER BY open_time) AS rn\n    FROM trades_real\nWHERE open_time >= $__fromTime\n  AND open_time <= $__toTime\n),\ngroups AS (\n    SELECT \n        profit,\n        rn,\n        rn - row_number() OVER (PARTITION BY (profit < 0) ORDER BY rn) AS grp\n    FROM numbered\n),\nstreaks AS (\n    SELECT \n        count(*) AS streak_length\n    FROM groups\n    WHERE profit < 0\n    GROUP BY grp\n)\nSELECT \n    ifNull(max(streak_length), 0) AS \" \"\nFROM streaks",
          "refId": "Max Loss Streak"
        }

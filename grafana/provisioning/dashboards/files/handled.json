          "rawSql": "SELECT\n  c.open_time AS time,\n  t.take_profit AS value\nFROM\n(\n  SELECT open_time\n  FROM candles_traded\n  WHERE trade_id = '${trade_id}'\n  ORDER BY open_time\n) c\nCROSS JOIN\n(\n  SELECT take_profit\n  FROM trades_real\n  WHERE id = '${trade_id}'\n  LIMIT 1\n) t\nORDER BY time",

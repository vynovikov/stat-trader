          "queryType": "timeseries",
          "rawSql": "WITH trade AS (\n  SELECT\n    t.entry_price,\n    t.candle_action,\n    t.open_time AS trade_time,\n    dateDiff('minute', c.open_time, c.close_time) AS timeframe_minutes\n  FROM trades_real t\n  LEFT JOIN (\n    SELECT trade_id, open_time, close_time\n    FROM candles_traded\n    WHERE trade_id = ${trade_id}\n    LIMIT 1\n  ) c ON t.id = c.trade_id\n  WHERE t.id = ${trade_id}\n  LIMIT 1\n)\nSELECT\n  time,\n  if(candle_action = 'buy', entry_price, NULL) AS entry_buy,\n  if(candle_action = 'sell', entry_price, NULL) AS entry_sell\nFROM (\n  SELECT trade_time AS time, entry_price, candle_action FROM trade\n  UNION ALL\n  SELECT trade_time + INTERVAL ifNull(timeframe_minutes, 5) MINUTE AS time, entry_price, candle_action FROM trade\n) AS points\nORDER BY time",

# ==============================================
# Vector Trader - Environment Configuration
# ==============================================
# Скопируйте этот файл в .env и настройте под свои нужды
# cp config.env.example .env

# ==============================================
# Trading Configuration
# ==============================================
SYMBOL=BTCUSDT
TIMEFRAME=5m

# ==============================================
# Stock Interactor (Go Service)
# ==============================================
BINANCE_CANDLES_LIMIT=1000
TRANSPORT_SEMAPHORE_SIZE=4
ADDRESS_GRPC=:5001

# ==============================================
# Trade Engine (Python Service)
# ==============================================
LOCAL_ADDR=:5002
BACKEND_ADDR=stock-interactor:5001

# ==============================================
# Qdrant Vector Database
# ==============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
VECTOR_DIMENSION=44
DISTANCE_METRIC=Cosine

# ==============================================
# ML Parameters
# ==============================================
A_LEN=8
WINDOW_SIZE=100

# ==============================================
# Deal Status Codes
# ==============================================
BUY_DEAL_WITH_PROFIT=BUY_PROFIT
SELL_DEAL_WITH_PROFIT=SELL_PROFIT
BUY_DEAL_WITH_LOSS=BUY_LOSS
SELL_DEAL_WITH_LOSS=SELL_LOSS
BUY_DEAL_HIT_SL=BUY_SL
SELL_DEAL_HIT_SL=SELL_SL

